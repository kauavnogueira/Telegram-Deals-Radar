# ==========================================
# Telegram API Credentials (https://my.telegram.org)
# ==========================================
# Obtenha suas credenciais em https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Sessão salva MTProto gerada automaticamente com "npm run setup" ou "npm run login"
TELEGRAM_STRING_SESSION=

# Telefone da sua conta com DDI e DDD (ex: +5511999998888)
TELEGRAM_PHONE_NUMBER=

# Canais / Grupos iniciais para monitorar (separados por vírgula)
# Podem ser alterados ou gerenciados em tempo real na própria Dashboard!
TELEGRAM_CHANNELS=@promobitoficial,@ofertaztelegram
