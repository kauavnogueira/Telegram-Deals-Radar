# ==========================================
# Telegram API Credentials (https://my.telegram.org)
# ==========================================
# Obtenha suas credenciais em https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Sessão salva MTProto gerada automaticamente com "npm run setup" ou "npm run login"
TELEGRAM_STRING_SESSION=

# Telefone da sua conta com DDI e DDD (ex: +5511999998888)
TELEGRAM_PHONE_NUMBER=

# Canais / Grupos iniciais para monitorar (separados por vírgula)
# Podem ser alterados ou gerenciados em tempo real na própria Dashboard!
TELEGRAM_CHANNELS=@promobitoficial,@ofertaztelegram

# ==========================================
# Notificações no Telegram Privado (Bot API)
# ==========================================
# Token do bot criado no @BotFather no Telegram (ex: 123456789:ABCdefGHI...)
TELEGRAM_BOT_TOKEN=

# Seu Chat ID pessoal do Telegram (obtenha enviando /start para @userinfobot)
TELEGRAM_USER_CHAT_ID=

# Ativar/desativar notificações privadas (true ou false)
TELEGRAM_NOTIFY_ENABLED=true

# Desconto mínimo (%) para receber alerta (ex: 20 para ofertas a partir de 20% OFF, ou 0 para todas)
TELEGRAM_NOTIFY_MIN_DISCOUNT=0

# Palavras-chave específicas de interesse separadas por vírgula (deixe vazio para receber tudo)
# Ex: iphone, ps5, notebook, rtx
TELEGRAM_NOTIFY_KEYWORDS=
